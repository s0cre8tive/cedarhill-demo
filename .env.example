# On your computer: a simple file database. Leave as-is to try the demo.
DATABASE_URL=file:./cedarhill.db

# Any long random string. Keep it secret.
PAYLOAD_SECRET=replace-with-a-long-random-string

# The site's address.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: where "new form response" alerts go once an email service is connected.
NOTIFY_EMAIL=

# --- Going live (set these in Vercel, not in this file) ---
# DATABASE_URL=postgresql://...        (from Neon; the site switches to Postgres automatically)
# BLOB_READ_WRITE_TOKEN=...            (added for you when you connect Vercel Blob)
# FIRST_ADMIN_EMAIL=you@example.com    (only this email can create the first dashboard account)
# KIT_PACKAGE=cathedral                (chapel, sanctuary or cathedral. Cathedral turns on Team Communication. Empty = cathedral)
# RESEND_API_KEY=... and EMAIL_FROM=... (sends reminders, the Sunday Recap and team emails)
# CRON_SECRET=...                      (lets Vercel run the nightly reset, the daily jobs and the Thursday rundown)
